# انسخ هذا الملف باسم .env ثم عدّل القيم (السطور اللي بتبدأ بـ # تعليقات)

# المنفذ اللي يشتغل عليه النظام
PORT=3000

# 0.0.0.0 = متاح للأجهزة في نفس الشبكة،  127.0.0.1 = على هذا الجهاز فقط (استخدمه خلف Nginx)
HOST=0.0.0.0

# مجلد البيانات (قاعدة البيانات + الملفات المرفوعة + النسخ الاحتياطية). غيّره لمسار ثابت في الاستضافة
# DATA_DIR=./data

# الحد الأقصى لحجم الملف المرفوع بالميجا
MAX_UPLOAD_MB=50

# حساب المالك: بيتنشأ تلقائيًا أول مرة فقط. ⚠️ على الاستضافة اختر رقمًا سريًا قويًا قبل أول تشغيل
OWNER_NAME=المالك
OWNER_PIN=123456

# فعّلها (1) لما تشغّل خلف وسيط HTTPS مثل Nginx أو Cloudflare
# TRUST_PROXY=1
# COOKIE_SECURE=1

# اختياري: مفتاح تشفير الجلسات. لو تركته فاضي بيتولّد تلقائيًا ويتحفظ مع البيانات
# SECRET=
