# مثال إعداد Nginx كوسيط HTTPS أمام النظام (غيّر example.com)
server {
    listen 80;
    server_name example.com;

    client_max_body_size 60m;     # أكبر من MAX_UPLOAD_MB

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
# بعد ذلك فعّل HTTPS مجانًا بالأمر:  sudo certbot --nginx -d example.com
# وفي ملف .env ضع:  HOST=127.0.0.1  و  TRUST_PROXY=1  و  COOKIE_SECURE=1
